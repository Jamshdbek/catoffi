{
  "name": "cat-offi",
  "version": "1.0.4",
  "description": "Beautiful Pomodoro & Focus Timer Desktop App built with Electron + Vite + React + Tailwind",
  "main": "electron/main.cjs",
  "author": "Cat Offi",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "build": "vite build",
    "preview": "vite preview",
    "electron:build": "vite build && electron-builder",
    "electron:build:mac": "vite build && electron-builder --mac",
    "electron:publish:mac": "dotenv -e .env -- bash -c 'GH_TOKEN=$GITHUB_TOKEN vite build && GH_TOKEN=$GITHUB_TOKEN electron-builder --mac --publish always'",
    "electron:publish:win": "dotenv -e .env -- bash -c 'GH_TOKEN=$GITHUB_TOKEN vite build && GH_TOKEN=$GITHUB_TOKEN electron-builder --win --publish always'",
    "electron:build:win": "vite build && electron-builder --win",
    "electron:build:all": "vite build && electron-builder -mw"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "framer-motion": "^11.11.17",
    "lottie-react": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^11.0.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.cat-offi.app",
    "productName": "CatOffi",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "public/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png",
      "extraFiles": [
        {
          "from": "node_modules/electron/dist/ffmpeg.dll",
          "to": "ffmpeg.dll"
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "Jamshdbek",
      "repo": "catoffi"
    }
  }
}
